# ── Client (exposed to the browser via Vite) ──────────────────────────────
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here
VITE_API_BASE=                       # e.g. https://advysr.org (empty = same origin)

# ── Server only (Vercel env vars; never prefix with VITE_) ────────────────
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=           # bypasses RLS — server only
ANTHROPIC_API_KEY=
NEWS_API_KEY=
APP_URL=https://advysr.org
ALLOWED_ORIGINS=                     # optional extra CORS origins, comma-separated
